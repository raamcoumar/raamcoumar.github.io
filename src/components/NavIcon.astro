---
export interface Props {
  href: string;
  icon: string;
  label: string;
  external?: boolean;
}

const { href, icon, label, external = false } = Astro.props;
---

<a
  href={href}
  {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
  class="flex flex-col items-center gap-1 p-3 rounded-xl text-gray-400 hover:text-gray-700 hover:bg-gray-100/80 transition-colors group"
  title={label}
>
  <span class="text-lg" aria-hidden="true">{icon}</span>
  <span class="text-[10px] font-medium uppercase tracking-wider opacity-0 group-hover:opacity-100 transition-opacity">
    {label}
  </span>
</a>
