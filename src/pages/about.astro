---
import Layout from '../layouts/Layout.astro';
import Window from '../components/Window.astro';
import Sidebar from '../components/Sidebar.astro';
---

<Layout>
  <Window>
    <div class="flex gap-8">
      <!-- Left sidebar -->
      <aside class="hidden md:flex shrink-0 pt-2">
        <Sidebar />
      </aside>

      <!-- Main content -->
      <div class="flex-1 min-w-0 space-y-10">
        <!-- Page title -->
        <div>
          <a href="/" class="text-xs text-gray-400 hover:text-gray-600 transition-colors mb-3 inline-block">
            ← Home
          </a>
          <h1 class="text-3xl font-bold text-gray-900">About</h1>
        </div>

        <!-- Bio -->
        <div class="space-y-4 text-sm text-gray-600 leading-relaxed max-w-prose">
          <p>
            I'm a marketing professional based in Chennai, India, with 5+ years of experience
            across growth strategy, content, and marketing operations. What sets me apart:
            I build AI agent workflows that make marketing teams move faster and smarter.
          </p>
          <p>
            I run Hermes AI agents on my Linux homelab, self-host services with Docker,
            and wire up automation pipelines that save hours of manual work every week.
            I don't write code from scratch — I direct AI-assisted builds, which means I
            ship working tools at the speed of conversation.
          </p>
          <p>
            When I'm not tinkering with agents, I'm reading on Substack, watching films,
            or exploring ways to get fitter and take better care of myself. I live with my
            wife, and we're working toward moving abroad in the next few years.
          </p>
          <p>
            I'm open to roles where marketing meets AI — growth, product marketing, or
            marketing operations at companies that are serious about using technology
            to get an edge.
          </p>
        </div>

        <!-- Skills -->
        <div>
          <h2 class="text-[11px] font-semibold uppercase tracking-[0.2em] text-gray-400 mb-4">
            Skills & Tools
          </h2>
          <div class="flex flex-wrap gap-2">
            {
              [
                'AI Agent Workflows',
                'Marketing Strategy',
                'Growth & Analytics',
                'Content Strategy',
                'Docker & Self-hosting',
                'Linux',
                'Git & GitHub',
                'Hermes AI',
                'Claude/LLMs',
                'Discord Bots',
                'Automation',
                'Markdown/Tech Writing',
              ].map((skill) => (
                <span class="text-xs font-medium px-3 py-1.5 rounded-full bg-gray-100 text-gray-600">
                  {skill}
                </span>
              ))
            }
          </div>
        </div>

        <!-- Experience timeline (simple) -->
        <div>
          <h2 class="text-[11px] font-semibold uppercase tracking-[0.2em] text-gray-400 mb-4">
            Career Snapshot
          </h2>
          <div class="space-y-4">
            <div class="flex gap-4">
              <div class="text-xs text-gray-400 w-24 shrink-0 pt-0.5">2023 – Present</div>
              <div>
                <h3 class="text-sm font-medium text-gray-800">Senior Marketing Role</h3>
                <p class="text-xs text-gray-500 mt-0.5">
                  Leading growth initiatives, building AI-powered workflows, and managing
                  cross-channel campaigns.
                </p>
              </div>
            </div>
            <div class="flex gap-4">
              <div class="text-xs text-gray-400 w-24 shrink-0 pt-0.5">2021 – 2023</div>
              <div>
                <h3 class="text-sm font-medium text-gray-800">Marketing Specialist</h3>
                <p class="text-xs text-gray-500 mt-0.5">
                  Content strategy, campaign execution, and marketing analytics across
                  multiple channels.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Contact CTA -->
        <div class="border-t border-gray-100 pt-6 flex items-center justify-between">
          <p class="text-xs text-gray-500">Open for opportunities</p>
          <a
            href="mailto:hello@raamcoumar.dev"
            class="text-sm font-semibold text-gray-800 hover:text-gray-600 transition-colors"
          >
            Let's talk →
          </a>
        </div>
      </div>
    </div>
  </Window>
</Layout>
